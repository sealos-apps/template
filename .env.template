# Git certificate verification for template repository clone/pull.
# Default: false (verify certificates). For direct container deployments only,
# set true to allow a repository served with a platform self-signed certificate.
# Helm injects this automatically from platform.tlsRejectUnauthorized:
# "1" => false; "0" => true. The installer resolves that existing setting from
# the platform certificate mode; override with HELM_OPTS='--set-string platform.tlsRejectUnauthorized=1'.
GIT_SSL_NO_VERIFY=false
